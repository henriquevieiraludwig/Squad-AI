# ---------- Servidor ----------
PORT=3001
# Endereço público HTTPS da plataforma (retornos de OAuth, webhooks e links dos e-mails)
PUBLIC_URL=https://app.squadai.com.br
# Endereço do site, se diferente do PUBLIC_URL (ex.: Vite em desenvolvimento)
# APP_URL=http://localhost:5173
# 32 bytes em base64 para criptografar as credenciais. Gere uma vez e nunca troque:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
DEFAULT_TIMEZONE=America/Sao_Paulo
# Primeiro acesso sem terminal: o link do convite do administrador aparece no log ao ligar
# BOOTSTRAP_ADMIN_EMAIL=voce@empresa.com

# ---------- Banco de dados ----------
# Produção: PostgreSQL da Supabase. Use a string do "Session pooler" (Connect > Session pooler, porta 5432).
# Sem esta variável, usa o PGlite (Postgres embutido) em data/pglite.
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------- White label ----------
PLATFORM_NAME=Squad AI
PLATFORM_SLUG=squad-ai
# Cada parceiro novo ganha automaticamente <slug>.<este domínio> (exige DNS curinga *.squadai.com.br)
# PARTNER_SUBDOMAIN_BASE=squadai.com.br

# ---------- Agentes (API do Claude) ----------
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# ---------- E-mails (Resend) ----------
# Sem RESEND_API_KEY, os e-mails aparecem só no log do servidor.
RESEND_API_KEY=
EMAIL_FROM=nao-responda@squadai.com.br

# ---------- Monitoramento (opcional) ----------
# SENTRY_DSN=

# ---------- Microsoft 365 (Outlook, Calendário, Teams, OneDrive) ----------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# ---------- Google Workspace (Gmail, Agenda, Chat) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Só depois da avaliação de segurança do Google (CASA): libera buscar e-mails e arquivos.
# GOOGLE_RESTRICTED_SCOPES=true

# ---------- Slack ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------- WhatsApp (Cloud API da Meta) ----------
# META_GRAPH_VERSION=v23.0
