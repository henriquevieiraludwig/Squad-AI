# ---------- Servidor ----------
PORT=3001
# Endereço público HTTPS da plataforma (usado nos retornos de OAuth e nos webhooks)
PUBLIC_URL=https://app.suaempresa.com.br
# Endereço do site, se for diferente do PUBLIC_URL (ex.: Vite em desenvolvimento)
# APP_URL=http://localhost:5173
# 32 bytes em base64 para criptografar as credenciais das integrações:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
DEFAULT_TIMEZONE=America/Sao_Paulo

# ---------- Agentes (API do Claude) ----------
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# ---------- Microsoft 365 (Outlook, Calendário, Teams, OneDrive) ----------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# ---------- Google Workspace (Gmail, Agenda, Drive, Chat) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Slack ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------- WhatsApp (Cloud API da Meta) ----------
# META_GRAPH_VERSION=v23.0
