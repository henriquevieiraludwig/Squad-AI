{
  "name": "squad-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --no-warnings=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:demo": "VITE_DEMO=1 vite build --outDir dist-demo --base ./ && node scripts/pack-demo.js",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^5.4.21"
  }
}
