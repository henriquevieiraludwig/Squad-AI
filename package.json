{
  "name": "squad-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --no-warnings=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:demo": "VITE_DEMO=1 vite build --outDir dist-demo --base ./ && node scripts/pack-demo.js",
    "start": "NODE_ENV=production node server/index.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "db:check": "node scripts/db-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@electric-sql/pglite": "^0.3.16",
    "@sentry/node": "^9.47.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20.12"
  }
}
